# Committed template. Copy to .env, which is gitignored, and fill in real values.
#
# Section 5: every secret is read through a ${ENV_VAR} placeholder with NO
# default value, and the application fails fast at startup when one is missing.
# A placeholder that silently falls back to a dev value is how a dev credential
# reaches production.
#
# Keep this file in sync with the "Project-specific secrets" table of CLAUDE.md:
# a variable in one and not the other is a variable nobody will set.

# --- database ----------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/{{DB_NAME}}
DB_USERNAME=
DB_PASSWORD=

# --- application -------------------------------------------------------
{{APP_SECRET_VAR}}=

# --- frontend (build time) ---------------------------------------------
# The API base URL comes from the build environment, never from a literal in
# the sources: frontend-dist.yml fails the build when the bundle carries the
# repository's forbidden pattern.
API_BASE_URL=
